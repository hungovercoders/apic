---
// Starlight's footer, plus the one-line privacy statement every page
// carries. Keep the line and privacy.md true to the site: a third-party
// script, a form or an analytics snippet means updating both (see
// docs/docs-site.md).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="privacy">
	Hosted on Cloudflare, which keeps aggregate traffic statistics and the short-lived request logs needed to
	serve the site. No cookies, no tracking scripts. <a href="/privacy/">Privacy</a>
</p>

<style>
	.privacy {
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		text-align: center;
		color: var(--sl-color-gray-3);
	}
</style>
